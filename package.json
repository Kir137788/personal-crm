{
  "name": "personal-crm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "docker compose -f compose.e2e.yaml up -d --wait && node --conditions=react-server --import tsx scripts/test-keep-in-touch.mts",
    "test:e2e": "docker compose -f compose.e2e.yaml up -d --wait && playwright test",
    "test:e2e:ui": "docker compose -f compose.e2e.yaml up -d --wait && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "drizzle-orm": "latest",
    "postgres": "latest",
    "zod": "latest",
    "lucide-react": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "tailwind-merge": "latest",
    "@radix-ui/react-slot": "latest",
    "server-only": "latest"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "dotenv": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "@playwright/test": "1.64.1",
    "vitest": "5.1.0"
  }
}
